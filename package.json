{
  "name": "videos-downloader",
  "version": "1.1.0",
  "description": "Videos Downloader - download YouTube playlists and videos as MP4 or MP3",
  "author": "Lucas Salomão Boschiroli",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^44.11.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.videosdownloader.app",
    "productName": "Videos Downloader",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Videos-Downloader-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "lucasboschiroli",
      "repo": "Videos_Downloader",
      "releaseType": "draft"
    }
  },
  "allowScripts": {
    "electron@44.11.3": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
